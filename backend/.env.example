# ---------------------------------------------------------------------------
# RemotePhonebook backend configuration. Copy to .env and fill in.
# Never commit real credentials.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgres://rpb:rpb_dev_password@localhost:5432/remotephonebook

# Public base URL of this API (must be https:// in production)
API_BASE_URL=http://localhost:4000

# Random secret, at least 32 characters. Used to HMAC session tokens, one-time codes and rate-limit keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-value-0123456789

# Set to true when running behind a TLS-terminating proxy/load balancer
TRUST_PROXY=false
CORS_ORIGINS=*
SESSION_TTL_HOURS=720
DEFAULT_PHONE_REGION=KE
DISPLAY_TIMEZONE=Africa/Nairobi
# Require email/SMS verification before an account can log in (keep true in production)
REQUIRE_VERIFICATION=true

# --- Africa's Talking ------------------------------------------------------
# mock    = never contacts Africa's Talking; SMS/email go to the dev outbox (GET /api/dev/outbox)
# sandbox = api.sandbox.africastalking.com (use username "sandbox" and your sandbox API key)
# live    = production API
AFRICASTALKING_ENV=mock
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
# Placeholder until Africa's Talking provisions your code (shared codes look like *384*1234#)
# Quote it: an unquoted "#" starts a comment in .env files.
AFRICASTALKING_USSD_SERVICE_CODE="*123#"
# Optional alphanumeric sender ID / short code registered with AT for SMS
AFRICASTALKING_SMS_FROM=
# Shared secret required as ?token=... on the USSD callback URL you register with AT
USSD_CALLBACK_TOKEN=
# Optional comma-separated IP allowlist for the callback (confirm AT's current IPs first)
USSD_ALLOWED_IPS=

# --- USSD behaviour --------------------------------------------------------
USSD_PAGE_SIZE=5
# Max characters per USSD screen (incl. "CON "). 182 is a safe default; some carriers allow less.
USSD_MAX_CHARS=182
USSD_SESSION_TTL_SECONDS=180
USSD_MAX_LOGIN_ATTEMPTS=3
# Require a one-time SMS/email code after the password when dialing from an untrusted phone
USSD_REQUIRE_OTP_FOR_UNTRUSTED=false
USSD_SMS_DAILY_LIMIT=20

# --- Modes -------------------------------------------------------------------
# Default: on in development/test, off in production
# DEMO_MODE_ENABLED=true
# Dev tools (/api/dev/*, USSD simulator, mock outbox). Always off in production.
# DEV_TOOLS_ENABLED=true
AUDIT_RETENTION_DAYS=365

# Contact sync tuning (JSON)
CONTACT_SYNC_SETTINGS={"maxBatchSize":500,"defaultDeletionPolicy":"mirror","tombstoneRetentionDays":90,"maxContactsPerUser":20000,"maxPullPageSize":1000}
